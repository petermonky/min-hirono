# Server-only. Do not prefix any of these values with NEXT_PUBLIC_.
HIRONO_ACCESS_PASSCODE=choose-a-long-private-passphrase
HIRONO_SESSION_SECRET=generate-at-least-32-random-characters

# Use `npm run db:status` after starting the local stack, or copy the URL and
# service-role/secret key from your hosted Supabase project settings.
SUPABASE_URL=http://127.0.0.1:56321
SUPABASE_SECRET_KEY=your-server-only-sb-secret-key
